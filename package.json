{
  "name": "Library",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.2.0",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch:hybrid": "cds watch --profile hybrid",
    "watch-list_object_library": "cds watch --open com.dhruv.listobjectlibrary/index.html?sap-ui-xx-viewCache=false --livereload false",
    "debug": "cds watch --debug",
    "debug:break": "cds watch --debug-brk",
    "debug:hybrid": "cds watch --profile hybrid --debug",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy Library --delete-services --delete-service-keys --delete-service-brokers",
    "watch-loan-management": "cds watch --open loanmanagement/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-library-overview": "cds watch --open com.dhruv.libraryoverview/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-library-analytics": "cds watch --open com.dhruv.libraryanalytics/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-notifications-ui": "cds watch --open com.dhruv.notificationsui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "connectivity": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/list_object_library",
    "app/loan-management",
    "app/library-overview",
    "app/library-analytics",
    "app/notifications-ui"
  ]
}
